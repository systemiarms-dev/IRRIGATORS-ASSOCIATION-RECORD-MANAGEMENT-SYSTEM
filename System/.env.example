# ============================================================
# IARMS Environment Configuration
# Copy to .env.local and fill in real values.
# ============================================================

# REQUIRED: Session signing secret (used to verify login cookies).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be kept secret and set to the same value on every deployment.
IARMS_SESSION_SECRET=

# Set to 'true' only when the app is served over HTTPS (e.g. behind a reverse proxy).
IARMS_COOKIE_SECURE=false

# Optional (not used by the offline JSON backend):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
